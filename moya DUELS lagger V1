local function toggleLagger()
    laggerActive = not laggerActive
    local targetPos = laggerActive and UDim2.new(1, -18, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    TweenService:Create(toggleBall, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = targetPos
    }):Play()

    toggleClick.Text = laggerActive and "ACTIVE" or "INACTIVE"
    if laggerActive then
        toggleClick.TextColor3 = UI_CONFIG.ActiveGreen
    else
        toggleClick.TextColor3 = UI_CONFIG.InactiveRed
    end

    if laggerActive then
        if lagThread then task.cancel(lagThread) end
        lagThread = task.spawn(function()
            while laggerActive do
                pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000) end)
                bomb(NIVELES[nivelActual].poder)
                task.wait(0.18)
            end
        end)
    else
        if lagThread then task.cancel(lagThread); lagThread = nil end
    end
end

-- ═══════════════════════════════════════════
-- ANTI LAG BACK (background, from FR HUB logic)
-- Detects lag-back / rubberband and corrects position
-- ═══════════════════════════════════════════
local LBG = {
    hrp = nil,
    lastPos = nil,
    lastVelH = Vector3.zero,
    boostUntil = 0,
    lastFix = 0,
    pauseUntil = 0,
    abHold = 0,
    lastCrumb = 0,
    crumbs = {},
    conn = nil
}

local function getCharParts()
    local char = player.Character
    if not char then return nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return hum, hrp
end

local function lbgReset()
    LBG.lastPos = nil
    LBG.crumbs = {}
    LBG.lastCrumb = 0
end

local function lbgStep(dt)
    if not antiLagBackEnabled then
        lbgReset()
        return
    end
    local h, hrp = getCharParts()
    if not h or not hrp or not hrp.Parent then
        lbgReset()
        return
    end
    local st = h:GetState()
    if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.Dead then
        lbgReset()
        return
    end
    if LBG.hrp ~= hrp then
        lbgReset()
        LBG.hrp = hrp
    end

    local md = h.MoveDirection
    local now = tick()
    local pos = hrp.Position
    local vel = hrp.AssemblyLinearVelocity
    local spd = h.WalkSpeed or 16
    local rawHs = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local cleanH = Vector3.new(vel.X, 0, vel.Z)
    local crumbs = LBG.crumbs

    if LBG.lastPos and dt > 0 and now - LBG.lastFix > 3 and now > LBG.pauseUntil and now > LBG.abHold then
        local step = Vector3.new(pos.X - LBG.lastPos.X, 0, pos.Z - LBG.lastPos.Z).Magnitude
        if step > 12 and step < 500 then
            for k = 1, #crumbs do
                local c = crumbs[k]
                if now - c.t >= 0.4
                    and Vector3.new(pos.X - c.p.X, 0, pos.Z - c.p.Z).Magnitude < 8
                    and Vector3.new(LBG.lastPos.X - c.p.X, 0, LBG.lastPos.Z - c.p.Z).Magnitude > 12 then
                    if LBG.lastFix > 0 and now - LBG.lastFix < 8 then
                        LBG.pauseUntil = now + 15
                        break
                    end
                    local newPos = Vector3.new(LBG.lastPos.X + LBG.lastVelH.X * dt, pos.Y, LBG.lastPos.Z + LBG.lastVelH.Z * dt)
                    hrp.CFrame = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)
                    if md.Magnitude > 0 and spd > 0 then
                        hrp.AssemblyLinearVelocity = Vector3.new(md.X * spd, vel.Y, md.Z * spd)
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
                    end
                    vel = hrp.AssemblyLinearVelocity
                    cleanH = Vector3.new(vel.X, 0, vel.Z)
                    LBG.lastFix = now
                    LBG.boostUntil = now + 0.6
                    pos = newPos
                    break
                end
            end
        end
    end

    LBG.lastPos = pos
    LBG.lastVelH = cleanH

    if now - LBG.lastCrumb >= 0.1 then
        LBG.lastCrumb = now
        table.insert(crumbs, {t = now, p = pos})
        while #crumbs > 0 and now - crumbs[1].t > 8 do
            table.remove(crumbs, 1)
        end
    end

    if now < LBG.abHold then return end
    if md.Magnitude <= 0 or spd <= 0 then return end
    if now > LBG.boostUntil then return end

    local hs = Vector3.new(vel.X, 0, vel.Z).Magnitude
    if hs < spd - 1 then
        local nhs = math.min(spd, hs + spd * 0.5)
        hrp.AssemblyLinearVelocity = Vector3.new(md.X * nhs, vel.Y, md.Z * nhs)
    end
end

local function setAntiLagBack(on)
    antiLagBackEnabled = on == true
    if antiLagBackEnabled then
        if not LBG.conn then
            LBG.conn = RunService.Heartbeat:Connect(function(dt)
                pcall(lbgStep, dt)
            end)
        end
    else
        if LBG.conn then
            LBG.conn:Disconnect()
            LBG.conn = nil
        end
        lbgReset()
    end
    actualizarAntiLagBtn()
    SaveConfig()
end

